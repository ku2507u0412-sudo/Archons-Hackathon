ALTER TABLE reserves ADD COLUMN depth_meters DECIMAL(10,2); -- Adjust data type as needed
CREATE TABLE IF NOT EXISTS reserves (
    borehole_id INTEGER PRIMARY KEY,
    latitude REAL,
    longitude REAL,
    depth_meters REAL,
    manganese_grade_percent REAL,
    target_label INTEGER
);

